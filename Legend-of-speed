-- ============ UI UTILITIES ============
local function tween(inst, props, dur, style, dir, cb)
    local t = TweenService:Create(inst,
        TweenInfo.new(dur or 0.2,
            style or Enum.EasingStyle.Quad,
            dir or Enum.EasingDirection.Out),
        props)
    t:Play()
    if cb then t.Completed:Connect(cb) end
    return t
end
local function corner(inst, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 6)
    c.Parent = inst
    return c
end
local function stroke(inst, color, thick, trans)
    local s = Instance.new("UIStroke")
    s.Color = color or C.cyan
    s.Thickness = thick or 1
    s.Transparency = trans or 0.4
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = inst
    return s
end
local function grad(inst, a, b, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(a, b)
    g.Rotation = rot or 0
    g.Parent = inst
    return g
end
local function ripple(btn, color)
    btn.ClipsDescendants = true
    btn.MouseButton1Down:Connect(function()
        local mouse = UserInputService:GetMouseLocation()
        local rel = mouse - btn.AbsolutePosition
        local r = Instance.new("Frame")
        r.AnchorPoint = Vector2.new(0.5, 0.5)
        r.Size = UDim2.new(0, 0, 0, 0)
        r.Position = UDim2.new(0, rel.X, 0, rel.Y)
        r.BackgroundColor3 = color or Color3.new(1, 1, 1)
        r.BackgroundTransparency = 0.5
        r.BorderSizePixel = 0
        r.ZIndex = 20
        r.Parent = btn
        Instance.new("UICorner", r).CornerRadius = UDim.new(1, 0)
        tween(r, { Size = UDim2.new(0, 340, 0, 340), BackgroundTransparency = 1 },
            0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out,
            function() r:Destroy() end)
    end)
end
local function hover(btn, normal, hi)
    btn.BackgroundColor3 = normal
    btn.MouseEnter:Connect(function() tween(btn, { BackgroundColor3 = hi }, 0.15) end)
    btn.MouseLeave:Connect(function() tween(btn, { BackgroundColor3 = normal }, 0.2) end)
end
local function tapPulse(btn)
    -- simulate haptic via brightness flash on tap
    local orig = btn.BackgroundTransparency
    btn.MouseButton1Down:Connect(function()
        btn.BackgroundTransparency = math.max(0, orig - 0.3)
    end)
    btn.MouseButton1Up:Connect(function()
        tween(btn, { BackgroundTransparency = orig }, 0.2)
    end)
end
local function pulse(s, on)
    if on then
        return TweenService:Create(s,
            TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
            { Transparency = 0.8 })
    end
end
local function divider(parent, y, w)
    local d = Instance.new("Frame")
    d.Size = UDim2.new(1, w or -20, 0, 1)
    d.Position = UDim2.new(0, 10, 0, y)
