-- ============ TOKEN BUCKET ============
local Bucket = { tokens = Config.BucketSize, lastRefill = os.clock() }
local function refillBucket()
    local now = os.clock()
    local dt = now - Bucket.lastRefill
    Bucket.lastRefill = now
    Bucket.tokens = math.min(Config.BucketSize, Bucket.tokens + Config.BucketRate * dt)
end
local function spendTokens(n)
    refillBucket()
    local allowed = math.min(n, math.floor(Bucket.tokens))
    Bucket.tokens -= allowed
    return allowed
end
RunService.Heartbeat:Connect(refillBucket)
