-- ============ FIRE ============
local function fireOrbs()
    local place = Config.SelectedPlace
    local orbs  = getActiveOrbs()
    if #orbs == 0 then return end
    local totalFired = 0
    for _, orb in ipairs(orbs) do
        local want = Config.OrbBurst
        while want > 0 do
            local allowed = spendTokens(want)
            if allowed <= 0 then task.wait(0.02) break end
            for _ = 1, allowed do
                orbEvent:FireServer("collectOrb", orb, place)
            end
            totalFired += allowed
            want -= allowed
            if Config.AntiLag and allowed >= 10 then task.wait() end
        end
    end
    Stats.orbsFired += totalFired
    if Hooks.onFire and totalFired > 0 then
        Hooks.onFire(totalFired, orbs)
    end
end

task.spawn(function()
    while true do
        if Config.AutoOrb and getHum() then pcall(fireOrbs) end
        task.wait(Config.OrbRate)
    end
end)
