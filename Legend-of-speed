    stroke(sheet, C.cyan, 1, 0.5)

    local sheetLbl = Instance.new("TextLabel")
    sheetLbl.Size = UDim2.new(1, -20, 1, -20)
    sheetLbl.Position = UDim2.new(0, 10, 0, 10)
    sheetLbl.BackgroundTransparency = 1
    sheetLbl.Text = "Orb → place mapping:\n\nEthereal Orb  →  Magma, Universe, Electric Cave, Jungle Cave\nGreen Orb  →  Universe only\nOrange Orb  →  Universe only\nGem  →  every island\n\nRebirth requires level 50, +25 per rebirth.\nRebirth target stops farming early — good for island unlocks."
    sheetLbl.TextColor3 = C.muted
    sheetLbl.TextXAlignment = Enum.TextXAlignment.Left
    sheetLbl.TextYAlignment = Enum.TextYAlignment.Top
    sheetLbl.Font = Enum.Font.Gotham
    sheetLbl.TextSize = 10
    sheetLbl.ZIndex = 7
    sheetLbl.Parent = sheet

    sectionLabel(infoTab, "CREDITS", 376)

    local footer = Instance.new("TextLabel")
    footer.Size = UDim2.new(1, -20, 0, 40)
    footer.Position = UDim2.new(0, 10, 0, 398)
    footer.BackgroundTransparency = 1
    footer.Text = "ofx · absolute ollie · 6767\n3 eyes · 1 fridge · 1 bench"
    footer.TextColor3 = C.muted
    footer.TextXAlignment = Enum.TextXAlignment.Left
    footer.Font = Enum.Font.Code
    footer.TextSize = 10
    footer.ZIndex = 6
    footer.Parent = infoTab

    -- live stat updater
    task.spawn(function()
        while orbsFiredLbl and orbsFiredLbl.Parent do
            task.wait(0.25)
            orbsFiredLbl.Text = tostring(Stats.orbsFired)
            local el = os.clock() - Stats.startTime
            local m = math.floor(el / 60)
            local s = math.floor(el % 60)
            uptimeLbl.Text = string.format("uptime %02d:%02d", m, s)
        end
    end)

    -- ============== DRAG / SNAP ==============
    local dragging, dragInput, dragStart, startPos
    local TITLE_ZONE = 60  -- only top bar + tab bar draggable

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    -- Snap to nearest edge
                    local v = camera and camera.ViewportSize or Vector2.new(1920, 1080)
                    local curX = Main.AbsolutePosition.X + Main.AbsoluteSize.X / 2
                    local target
                    if curX < v.X / 2 then
                        target = UDim2.new(0, 12, startPos.Y.Scale,
                            math.clamp(Main.AbsolutePosition.Y, 10, v.Y - Main.AbsoluteSize.Y - 10))
                    else
                        target = UDim2.new(1, -Main.AbsoluteSize.X - 12, startPos.Y.Scale,
                            math.clamp(Main.AbsolutePosition.Y, 10, v.Y - Main.AbsoluteSize.Y - 10))
                    end
                    tween(Main, { Position = target }, 0.25,
                        Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                end
            end)
        end
    end)
    titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    -- ============== MINIMIZE ORB ==============
    MinimizeOrb = Instance.new("TextButton")
    MinimizeOrb.Size = UDim2.new(0, 56, 0, 56)
    MinimizeOrb.Position = UDim2.new(0, 16, 0.5, -28)
    MinimizeOrb.BackgroundColor3 = C.pink
    MinimizeOrb.BackgroundTransparency = 0.2
    MinimizeOrb.Text = "ollie"
    MinimizeOrb.TextColor3 = C.text
    MinimizeOrb.Font = Enum.Font.GothamBlack
    MinimizeOrb.TextSize = 11
    MinimizeOrb.AutoButtonColor = false
    MinimizeOrb.BorderSizePixel = 0
    MinimizeOrb.Visible = false
    MinimizeOrb.ZIndex = 40
    MinimizeOrb.Parent = GUI
    corner(MinimizeOrb, 28)
    local minOrbStroke = stroke(MinimizeOrb, C.cyan, 2, 0.2)
    local minOrbPulse = pulse(minOrbStroke, true)
    minOrbPulse:Play()

    local function minimizePanel()
        local fadeTo = Main.Position
        tween(Main, { Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 40, 0, 40) }, 0.25,
            Enum.EasingStyle.Back, Enum.EasingDirection.In, function()
                Main.Visible = false
                Main.Size = UDim2.new(0, 340, 0, 680)
                Main.Position = fadeTo
                MinimizeOrb.Visible = true
            end)
        tween(Blur, { Size = 0 }, 0.3)
    end

    local function restorePanel()
        MinimizeOrb.Visible = false
        Main.Visible = true
        Main.Size = UDim2.new(0, 40, 0, 40)
        tween(Main, { Size = UDim2.new(0, 340, 0, 680) }, 0.3,
            Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    minBtn.MouseButton1Click:Connect(minimizePanel)
    MinimizeOrb.MouseButton1Click:Connect(restorePanel)

    -- MinimizeOrb is draggable too
    local mDrag, mStart, mStartPos
    MinimizeOrb.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            mDrag = true
            mStart = input.Position
            mStartPos = MinimizeOrb.Position
        end
    end)
    MinimizeOrb.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            if mDrag then
                local delta = input.Position - mStart
                MinimizeOrb.Position = UDim2.new(
                    mStartPos.X.Scale, mStartPos.X.Offset + delta.X,
                    mStartPos.Y.Scale, mStartPos.Y.Offset + delta.Y
                )
            end
        end
    end)
    MinimizeOrb.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            mDrag = false
        end
    end)

    -- ============== BACKGROUND MOTION ==============
    task.spawn(function()
        while Main and Main.Parent do
            if not Config.ReducedMotion then
                tween(mainStroke, { Transparency = 0.25 }, 1.4)
                bgGrad.Rotation = (bgGrad.Rotation + 40) % 360
                task.wait(1.4)
                tween(mainStroke, { Transparency = 0.65 }, 1.4)
                bgGrad.Rotation = (bgGrad.Rotation + 40) % 360
                task.wait(1.4)
            else
                task.wait(0.5)
            end
        end
    end)

    -- blur pulse when AutoOrb is on
    task.spawn(function()
        while Main and Main.Parent do
            if Config.AutoOrb and not Config.ReducedMotion then
                tween(Blur, { Size = 4 }, 0.6)
                task.wait(1.4)
                tween(Blur, { Size = 1 }, 0.6)
            else
                if Blur.Size > 0 then
                    tween(Blur, { Size = 0 }, 0.3)
                end
            end
            task.wait(2)
        end
    end)

    -- ============== INIT ==============
    setTab("FARM")
    RefreshOrbList()

    -- Welcome toast
    task.delay(0.6, function()
        showToast("✦ ollie v8 ready · mobile", C.cyan)
    end)
end
