local function showTab(tabName)
    if currentTab == tabName then return end
    currentTab = tabName
    for name, page in pairs(pages) do
        if name == tabName then
            page.Visible = true
            page.Position = UDim2.new(0, 10, 0, 0)
            tween(page, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Position = UDim2.new(0, 0, 0, 0) })
        else
            page.Visible = false
        end
    end
    for name, btn in pairs(tabButtons) do
        if name == tabName then
            tween(btn, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { BackgroundColor3 = Color3.fromRGB(40, 40, 50), TextColor3 = Color3.fromRGB(255, 255, 255) })
            btn.UIStroke.Color = Color3.fromRGB(100, 200, 255)
        else
            tween(btn, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { BackgroundColor3 = Color3.fromRGB(20, 20, 25), TextColor3 = Color3.fromRGB(150, 150, 160) })
            btn.UIStroke.Color = Color3.fromRGB(50, 50, 60)
        end
    end
end

