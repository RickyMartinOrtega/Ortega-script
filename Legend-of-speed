    }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    
    local thumb = create("Frame", {
        Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Color3.fromRGB(200, 200, 210), Parent = track
    }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    
    local btn = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = frame
    })
    
    local function UpdateState(on)
        S[key] = on
        if on then
            tween(track, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { BackgroundColor3 = Color3.fromRGB(100, 200, 255) })
            tween(thumb, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, { Position = UDim2.new(1, -18, 0.5, -8), BackgroundColor3 = Color3.fromRGB(255, 255, 255) })
