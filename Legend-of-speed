-- ============ HELPERS ============
local function getHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function getActiveOrbs()
    local pool = PLACE_ORBS[Config.SelectedPlace] or {}
    local out = {}
    for _, o in ipairs(pool) do
        if Config.SelectedOrbs[o] then table.insert(out, o) end
    end
    return out
end
