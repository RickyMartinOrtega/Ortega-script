-- Returns a table of pet names from petsFolder.Unique
local function listOwnedPets()
    local names = {}
    local petsFolder = plr:FindFirstChild("petsFolder")
    if petsFolder then
        local unique = petsFolder:FindFirstChild("Unique")
        if unique then
            for _, p in ipairs(unique:GetChildren()) do
                if not table.find(names, p.Name) then table.insert(names, p.Name) end
            end
        end
    end
    table.sort(names)
    return names
end

-- Finds the pet object by name and fires equipPet
local function equipPet(petName)
    resolveRemotes()
    if not equipPetEvent then return false end
    local petsFolder = plr:FindFirstChild("petsFolder")
    local unique = petsFolder and petsFolder:FindFirstChild("Unique")
    if not unique then return false end

    for _, pet in ipairs(unique:GetChildren()) do
        if pet.Name == petName then
            -- CORRECT PAYLOAD: "equipPet", pet (object)
            return pcall(function()
                equipPetEvent:FireServer("equipPet", pet)
            end)
        end
    end
    return false
end

-- Finds the pet object by name and fires unequipPet
local function unequipPet(petName)
    resolveRemotes()
    if not equipPetEvent then return false end
    local petsFolder = plr:FindFirstChild("petsFolder")
    local unique = petsFolder and petsFolder:FindFirstChild("Unique")
    if not unique then return false end

    for _, pet in ipairs(unique:GetChildren()) do
        if pet.Name == petName then
            -- CORRECT PAYLOAD: "unequipPet", pet (object)
            return pcall(function()
                equipPetEvent:FireServer("unequipPet", pet)
            end)
        end
    end
    return false
end

-- Forcefully unequips ALL pets to clear desync slots
local function forceUnequipAll()
    resolveRemotes()
    if not equipPetEvent then return end
    local petsFolder = plr:FindFirstChild("petsFolder")
    local unique = petsFolder and petsFolder:FindFirstChild("Unique")
    if not unique then return end

    for _, pet in ipairs(unique:GetChildren()) do
        pcall(function()
            equipPetEvent:FireServer("unequipPet", pet)
        end)
        task.wait(0.05) -- Small delay to avoid rate limit
    end
end

